# Local single-host deployment. The Manager and deployment.compose.yml read
# the SAME file. Copy to .env.openflows and restrict its permissions to 0600.
# Production requires an isolated provisioner backend; see operator-deployment.md.
OPENFLOWS_MODE=local
OPENFLOWS_PUBLIC_URL=https://your-openflows-host
# Coder sends lifecycle-hook events to the Manager's public ingress. This
# must be reachable from the Coder container and must exactly match the URL
# served by the Manager/reverse proxy.
OPENFLOWS_HOOK_URL=https://your-openflows-host/api/v1/hooks/coder/chat
OPENFLOWS_MANAGER_ADDR=127.0.0.1:3002
OPENFLOWS_DATABASE_URL=postgres://openflows:replace-me@127.0.0.1:5544/openflows_control_plane
OPENFLOWS_PG_PASSWORD=replace-me
CODER_PG_PASSWORD=replace-me-too

# This directory persists encryption keys, imported GitHub credentials, and
# generated Coder credentials. Use an absolute path when sharing with containers.
OPENFLOWS_SECRET_DIR=.openflows/secrets

# Both browser and workspace containers must be able to reach this URL.
CODER_URL=https://your-coder-host
CODER_ACCESS_URL=${CODER_URL}
CODER_OAUTH2_GITHUB_CLIENT_ID=your-coder-github-oauth-client-id
# Choose your signup policy. For unrestricted GitHub signups, clear ALLOWED_ORGS
# and explicitly set ALLOW_EVERYONE=true.
CODER_OAUTH2_GITHUB_ALLOWED_ORGS=your-github-organization
CODER_OAUTH2_GITHUB_ALLOW_EVERYONE=false

# OpenFlows GitHub App metadata. Credentials are FILES in OPENFLOWS_SECRET_DIR:
# github-client-secret, github-app-private-key, github-webhook-secret.
# Coder GitHub login uses a separate file: coder-github-client-secret.
# Coder lifecycle-hook signing shares a 32-byte file: coder-hook-secret
# (`openssl rand -hex 32`); setup reuses it, do not rotate independently.
OPENFLOWS_GITHUB_CLIENT_ID=your-openflows-github-client-id
OPENFLOWS_GITHUB_APP_ID=123456
OPENFLOWS_GITHUB_APP_SLUG=your-openflows-app

OPENFLOWS_REDIS_ADMIN_URL=redis://127.0.0.1:6379
OPENFLOWS_RUNTIME_REDIS_URL=redis://redis:6379
OPENFLOWS_PROVISIONER_BACKEND=docker
OPENFLOWS_RELEASE_SOURCE=local
OPENFLOWS_RELEASE_NAME=2026.10.3
OPENFLOWS_WORKSPACE_IMAGE_DIGEST=sha256:replace-with-your-image-digest
